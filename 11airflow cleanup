import re, sys, json
d, cfg = sys.argv[1], sys.argv[2]
keys = {l.split('|')[0].strip() for l in open(cfg)}

# 1) acct: remove the extra MY_ from the 9 wrong names
p = d + '/acct_dependency_config.json'
s = open(p).read()
pat = re.compile(r'EBBS_MY_EBBS_MY_(ACCINFO|ACINTHIS|ACODINFO|EXCRTL|INTCURR|INTDTL|INTPL|MLTMAST|REASON)(?=[,"])')
s, n = pat.subn(r'EBBS_MY_EBBS_\1', s)
json.loads(s)
open(p, 'w').write(s)
print('acct: replaced', n, 'names')

# 2) prty: add PRTY-EBBS-MAST_EGLEX_MY block before PRTY-EBBS-REL_EGLEX_ID
p = d + '/prty_dependency_config.json'
s = open(p).read()
if '"PRTY-EBBS-MAST_EGLEX_MY"' in s:
    print('prty: MY block already exists, not added')
else:
    mast = 'EBBS_DF_MY_EBBS_MAST' if 'EBBS_DF_MY_EBBS_MAST' in keys else 'EBBS_MY_EBBS_MAST'
    deps = ','.join([mast, 'EBBS_MY_EBBS_SEG', 'EBBS_MY_EBBS_INSTCLS', 'EBBS_MY_EBBS_ARM',
                     'EBBS_MY_EBBS_MSTINFO', 'ALT_PRTY', 'ALT_PRTY-SCI-LSPSYSXREF', 'M_SCB_ENTITY_XLATE'])
    block = ('        "PRTY-EBBS-MAST_EGLEX_MY": {\n'
             '            "dependencies":\n'
             '            "' + deps + '",\n'
             '            "partition_details": "ods_val=${ods_val_param};country_val=MY;tp_sys_val=EBBS;process_id_val=PRTY-EBBS-MAST_EGLEX_ALL"\n'
             '        },\n')
    marker = '"PRTY-EBBS-REL_EGLEX_ID": {'
    assert s.count(marker) == 1, 'marker not unique'
    ls = s.rfind('\n', 0, s.index(marker)) + 1
    s = s[:ls] + block + s[ls:]
    json.loads(s)
    open(p, 'w').write(s)
    print('prty: added MY block using', mast)

# 3) verify both blocks against the CSV
def find(o, k):
    if isinstance(o, dict):
        if k in o: return o[k]
        for v in o.values():
            r = find(v, k)
            if r: return r
for f, k in [('acct_dependency_config.json', 'ACCT-EBBS-ACCOUNT_EGLEX_MY'),
             ('prty_dependency_config.json', 'PRTY-EBBS-MAST_EGLEX_MY')]:
    blk = find(json.load(open(d + '/' + f)), k)
    miss = [x.strip() for x in blk['dependencies'].split(',') if x.strip() not in keys]
    print(k, '-> not in EBBS CSV:', miss)
EOF









