def load_ebbs_rows(path):
    rows = []
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            parts = line.rstrip("\r\n").split("|")
            if len(parts) >= 5:
                rows.append((parts[0], parts[4]))
    return rows

def exists_for_country(rows, base_name, country):
    prefix = f"EBBS_{country}_"
    return any(f1.startswith(prefix) and name == base_name for f1, name in rows)

