def strip_country(key):
    for c in COUNTRIES:
        if key.endswith(f"_{c}"):
            return key[: -(len(c) + 1)], c
    return None, None

def tokens(dep_string):
    return {t.strip() for t in dep_string.split(",") if t.strip()}

for fname, new_entries in NEW_SERVICES.items():
    path = BASE_DIR / fname
    if not path.exists():
        print(f"=== {fname}: NOT FOUND at {path} ===")
        continue

    with open(path, encoding="utf-8") as f:
        data = json.load(f)

    known = {c: set() for c in COUNTRIES}
    for key, val in data.items():
        _, country = strip_country(key)
        if country:
            known[country] |= tokens(val.get("dependencies", ""))
    all_known = known["BD"] | known["PK"]

    print(f"\n=== {fname} ===")
    any_flag = False
    for base_name, dep_string in new_entries:
        draft_tokens = tokens(dep_string)

        for u in sorted(draft_tokens - all_known):
            any_flag = True
            close = difflib.get_close_matches(u, all_known, n=1, cutoff=0.7)
            hint = f" — closest existing match: '{close[0]}'" if close else " — no close match, may be genuinely new"
            print(f"  {base_name}: '{u}' never appears in this file{hint}")

        for country in COUNTRIES:
            other = [c for c in COUNTRIES if c != country][0]
            for t in sorted((draft_tokens - known[country]) & known[other]):
                any_flag = True
                print(f"  {base_name}_{country}: '{t}' exists under {other} here, not under {country} — confirm it should carry over")

    if not any_flag:
        print("  Every dependency name matches existing usage in this file.")
