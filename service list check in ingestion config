def format_entry(base_name, dependencies, country):
    return (
        f'    "{base_name}_{country}": {{\n'
        f'        "dependencies": "{dependencies}",\n'
        f'        "partition_details": "ods_val=${{ods_val_param}};country_val={country};tp_sys_val={TP_SYS};process_id_val={base_name}_ALL"\n'
        f'    }}'
    )

for fname, services in services_by_file.items():
    print(f"\n=== {fname} ===")
    blocks = [format_entry(name, deps, c) for name, deps in services for c in COUNTRIES]
    print(",\n".join(blocks))
