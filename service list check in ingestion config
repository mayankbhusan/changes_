print(f"Loaded {len(rows)} rows from {ebbs_path}\n")

non_ebbs = set()

for fname, services in NEW_SERVICES.items():
    flags, checked = [], 0
    for base_service_name, dep_string in services:
        for token in (t.strip() for t in dep_string.split(",") if t.strip()):
            if not token.startswith("EBBS_"):
                non_ebbs.add(token)
                continue
            checked += 1
            status = {c: exists_for_country(rows, token, c) for c in COUNTRIES}
            if not all(status.values()):
                summary = ", ".join(f"{c}={'Y' if v else 'MISSING'}" for c, v in status.items())
                flags.append(f"  {base_service_name}: {token} — {summary}")

    print(f"=== {fname}: {checked} EBBS_* tokens checked ===")
    print("\n".join(flags) if flags else "  All EBBS_* tokens confirmed present for every country.")
    print()

