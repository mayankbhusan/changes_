	id=`echo ${adm_hold} | cut -d ',' -f1`
	type=`echo ${adm_hold} | cut -d ',' -f2`
	start_date=`echo ${adm_hold} | cut -d ',' -f3`
	end_date=`echo ${adm_hold} | cut -d ',' -f4`
	if [[ ${lookup_id} == ${id} && ( ${end_date} > ${ods} || ${end_date} == ${ods} ) && ( ${ods} > ${start_date} || ${ods} == ${start_date} ) ]]
	then
		echo "id ${lookup_id} is present in hold configuration and end_date matches with configuration."
		return 10
	else
		echo "Service Name ${task_id} is not present in hold configuration. Hence proceed further"
		return 20
	fi
}
Adm_softexit
EOF
