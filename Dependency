import sys, logging, tempfile, shutil
from types import SimpleNamespace as NS

L = open(sys.argv[1]).read().splitlines()
s = [i for i, l in enumerate(L) if l.startswith("def write_to_recon(")][0]
e = next((j for j in range(s + 1, len(L)) if L[j] and not L[j][0].isspace() and not L[j].startswith("#")), len(L))
src = "\n".join(L[s:e]) + "\n"


class P:
    def __init__(self, *a, **k):
        pass

    def communicate(self):
        return ("", "")


sp = NS(PIPE=-1, Popen=P)


def run(country, push_ok):
    tmp = tempfile.mkdtemp()
    pushed, failed = [], []
    ns = dict(args=NS(product_name_upper="PRTY", partition_vars="a=1;b=2;tp=ACBS;pid=123", ods="2026-11-17"),
              logger=logging.getLogger("t"), filepath=tmp, hdfspath="/h/", recon_path="recon/", hadoop_mkdir="echo ",
              sp=sp, failed_countries=failed, push_recon_hdfs_check=lambda c, p: pushed.append(p) or push_ok)
    exec(src, ns)
    try:
        return ns["write_to_recon"](country, 0), pushed, failed
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


