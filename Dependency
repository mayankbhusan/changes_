cat > devcmp.py <<'EOF'
import sys, re, glob
notes, prod = sys.argv[1:3]
B = re.compile(r'"([^"\n]+)"\s*:\s*\{\s*"dependencies"\s*:\s*"([^"]*)"\s*,\s*"partition_details"\s*:\s*"([^"]*)"\s*\}')
dev = {}
for f in glob.glob(prod + '/*_dependency_config.json'):
    for m in B.finditer(open(f, 'rb').read().decode('utf-8', 'replace')):
        dev.setdefault(m.group(1), []).append((f.split('/')[-1], m.group(2), m.group(3)))
bad = n = 0
for m in B.finditer(open(notes, 'rb').read().decode('utf-8', 'replace')):
    k, d, p = m.groups(); n += 1
    hits = dev.get(k, [])
    if len(hits) != 1:
        print('FAIL  %-48s found %d time(s) in dev product configs' % (k, len(hits))); bad += 1; continue
    fn, dd, pp = hits[0]
    if dd != d:
        a, b = set(d.split(',')), set(dd.split(','))
        print('FAIL  %-48s deps differ (%s): only in notes %s | only in dev %s' % (k, fn, sorted(a - b), sorted(b - a))); bad += 1
    elif pp != p:
        print('FAIL  %-48s partition_details differ (%s)' % (k, fn)); bad += 1
    else:
        print('OK    %-48s %s' % (k, fn))
print('blocks in notes: %d | problems: %d' % (n, bad))
EOF
